# Process environment variables; .env is NOT loaded automatically.
AGENTIC_DEMO_DATA_DIR=./data
AGENTIC_DEMO_LOG_LEVEL=INFO
DEMO_USERNAME=demo
# Set a dedicated demo password (12+ characters) and a random secret (32+).
# Empty values deliberately prevent portal startup until configured.
DEMO_PASSWORD=
DEMO_SESSION_SECRET=

# Local demo broker only; no credentials in the URL.
NATS_URL=nats://127.0.0.1:4222

# Live model adapter: use only after approval, with synthetic demo requests.
# No model is selected automatically; the CLI also requires --allow-model-api.
AGENTIC_MODEL_PROVIDER=openai
AGENTIC_MODEL_NAME=
OPENAI_API_KEY=
AGENTIC_MODEL_TIMEOUT_SECONDS=30
AGENTIC_MODEL_MAX_RETRIES=1
AGENTIC_MODEL_MAX_OUTPUT_TOKENS=1200
# Paid pytest evaluations require --run-model AND this explicit opt-in.
AGENTIC_ALLOW_MODEL_API=0
